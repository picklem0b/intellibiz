{
	"name": "@intellibiz/plugin-stripe",
	"version": "1.0.1",
	"private": false,
	"type": "module",
	"description": "Stripe payment provider plugin for IntelliBiz — charges, refunds, webhooks, checkout",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --dts --clean",
		"dev": "tsdown src/index.ts --format esm,cjs --dts --watch",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"intellibiz",
		"stripe",
		"payments",
		"plugin"
	]
}

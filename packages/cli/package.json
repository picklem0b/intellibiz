{
	"name": "@intellibiz/cli",
	"version": "1.0.0",
	"type": "module",
	"private": false,
	"description": "Intellibiz CLI — dev server, build, audit, dashboard commands",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"intellibiz": "./dist/bin.cjs"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsdown src/index.ts src/bin.ts --format esm,cjs --dts --clean --sourcemap --target es2022",
		"dev": "tsdown src/index.ts src/bin.ts --format esm,cjs --dts --clean --sourcemap --target es2022 --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*",
		"citty": "^0.1.6",
		"consola": "^3.4.2",
		"pathe": "^2.0.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}

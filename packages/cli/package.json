{
	"name": "@intellibiz/cli",
	"version": "1.0.1",
	"private": false,
	"type": "module",
	"description": "Intellibiz CLI — dev server, build, audit, dashboard, and project scaffolding",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.mts",
	"bin": {
		"intellibiz": "./dist/index.cjs",
		"create-intellibiz": "./dist/create.cjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown src/index.ts src/create.ts --format esm,cjs --dts --clean",
		"dev": "tsdown src/index.ts src/create.ts --format esm,cjs --dts --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*",
		"citty": "^0.1.6",
		"consola": "^3.4.2",
		"pathe": "^2.0.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"bin": {
			"intellibiz": "./dist/index.cjs",
			"create-intellibiz": "./dist/create.cjs"
		}
	}
}

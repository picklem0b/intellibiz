{
	"name": "@intellibiz/legal",
	"version": "1.0.0",
	"description": "Digital licensing, invoicing, and GDPR compliance for intellibiz",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --dts --clean",
		"dev": "tsdown src/index.ts --format esm,cjs --dts --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	}
}

{
	"name": "intellibiz",
	"version": "1.0.1",
	"private": false,
	"type": "module",
	"description": "Intellibiz — Business Application Engine. The public face of the V1 framework.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.mts"
		},
		"./db": {
			"import": "./dist/db.mjs",
			"require": "./dist/db.cjs",
			"types": "./dist/db.d.mts"
		},
		"./finance": {
			"import": "./dist/finance.mjs",
			"require": "./dist/finance.cjs",
			"types": "./dist/finance.d.mts"
		},
		"./commerce": {
			"import": "./dist/commerce.mjs",
			"require": "./dist/commerce.cjs",
			"types": "./dist/commerce.d.mts"
		},
		"./identity": {
			"import": "./dist/identity.mjs",
			"require": "./dist/identity.cjs",
			"types": "./dist/identity.d.mts"
		},
		"./http": {
			"import": "./dist/http.mjs",
			"require": "./dist/http.cjs",
			"types": "./dist/http.d.mts"
		},
		"./config": {
			"import": "./dist/config.mjs",
			"require": "./dist/config.cjs",
			"types": "./dist/config.d.mts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts src/db.ts src/finance.ts src/commerce.ts src/identity.ts src/http.ts src/config.ts --format esm,cjs --dts --clean",
		"dev": "tsdown src/index.ts src/db.ts src/finance.ts src/commerce.ts src/identity.ts src/http.ts src/config.ts --format esm,cjs --dts --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*",
		"@intellibiz/db": "workspace:*",
		"@intellibiz/finance": "workspace:*",
		"@intellibiz/commerce": "workspace:*",
		"@intellibiz/identity": "workspace:*",
		"@intellibiz/http": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	}
}

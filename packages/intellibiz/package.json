{
	"name": "intellibiz",
	"version": "1.18.2",
	"type": "module",
	"private": false,
	"description": "Intellibiz — Business Application Engine. The batteries-included bundle on top of the @intellibiz/* packages.",
	"license": "Apache-2.0",
	"author": "Lethabo Khedama",
	"homepage": "https://github.com/picklem0b/intellibiz#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/picklem0b/intellibiz.git",
		"directory": "packages/intellibiz"
	},
	"bugs": {
		"url": "https://github.com/picklem0b/intellibiz/issues"
	},
	"keywords": [
		"intellibiz",
		"backend",
		"commerce",
		"fintech",
		"ledger",
		"multi-tenant",
		"money",
		"payments"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./commerce": {
			"import": {
				"types": "./dist/commerce.d.mts",
				"default": "./dist/commerce.mjs"
			},
			"require": {
				"types": "./dist/commerce.d.cts",
				"default": "./dist/commerce.cjs"
			}
		},
		"./finance": {
			"import": {
				"types": "./dist/finance.d.mts",
				"default": "./dist/finance.mjs"
			},
			"require": {
				"types": "./dist/finance.d.cts",
				"default": "./dist/finance.cjs"
			}
		},
		"./identity": {
			"import": {
				"types": "./dist/identity.d.mts",
				"default": "./dist/identity.mjs"
			},
			"require": {
				"types": "./dist/identity.d.cts",
				"default": "./dist/identity.cjs"
			}
		},
		"./http": {
			"import": {
				"types": "./dist/http.d.mts",
				"default": "./dist/http.mjs"
			},
			"require": {
				"types": "./dist/http.d.cts",
				"default": "./dist/http.cjs"
			}
		},
		"./config": {
			"import": {
				"types": "./dist/config.d.mts",
				"default": "./dist/config.mjs"
			},
			"require": {
				"types": "./dist/config.d.cts",
				"default": "./dist/config.cjs"
			}
		},
		"./db": {
			"import": {
				"types": "./dist/db.d.mts",
				"default": "./dist/db.mjs"
			},
			"require": {
				"types": "./dist/db.d.cts",
				"default": "./dist/db.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.mts",
				"default": "./dist/testing.mjs"
			},
			"require": {
				"types": "./dist/testing.d.cts",
				"default": "./dist/testing.cjs"
			}
		}
	},
	"files": ["dist"],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown src/index.ts src/config.ts src/commerce.ts src/finance.ts src/identity.ts src/http.ts src/db.ts src/testing.ts --format esm,cjs --dts --clean --sourcemap --target es2022",
		"dev": "tsdown src/index.ts src/config.ts src/commerce.ts src/finance.ts src/identity.ts src/http.ts src/db.ts src/testing.ts --format esm,cjs --dts --clean --sourcemap --target es2022 --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*",
		"@intellibiz/db": "workspace:*",
		"@intellibiz/finance": "workspace:*",
		"@intellibiz/commerce": "workspace:*",
		"@intellibiz/identity": "workspace:*",
		"@intellibiz/http": "workspace:*",
		"@intellibiz/testing": "workspace:*",
		"@intellibiz/cli": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}

{
	"name": "@intellibiz/http",
	"version": "1.18.2",
	"type": "module",
	"private": false,
	"description": "Intellibiz HTTP — Hono wrapper, RequestContext, middleware, routing",
	"license": "Apache-2.0",
	"author": "Lethabo Khedama",
	"homepage": "https://github.com/picklem0b/intellibiz#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/picklem0b/intellibiz.git",
		"directory": "packages/http"
	},
	"bugs": {
		"url": "https://github.com/picklem0b/intellibiz/issues"
	},
	"keywords": [
		"intellibiz",
		"hono",
		"http",
		"router",
		"middleware"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2022",
		"dev": "tsdown src/index.ts --format esm,cjs --dts --clean --sourcemap --target es2022 --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*",
		"@intellibiz/identity": "workspace:*",
		"hono": "^4.13.1"
	},
	"devDependencies": {
		"@hono/node-server": "^2.1.0",
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@hono/node-server": "^2.1.0"
	}
}

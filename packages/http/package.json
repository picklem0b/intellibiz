{
	"name": "@intellibiz/http",
	"version": "0.1.0",
	"private": false,
	"description": "Intellibiz HTTP — Hono wrapper, RequestContext, middleware, routing",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --dts --clean",
		"dev": "tsdown src/index.ts --format esm,cjs --dts --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/core": "workspace:*",
		"@intellibiz/identity": "workspace:*",
		"hono": "^4.13.1"
	},
	"devDependencies": {
		"@hono/node-server": "^2.1.0",
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@hono/node-server": "^2.1.0"
	}
}

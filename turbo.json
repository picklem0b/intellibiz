{
    "$schema": "https://turbo.build/schema.json",
    "concurrency": "100%",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "lint": {}
    }
}

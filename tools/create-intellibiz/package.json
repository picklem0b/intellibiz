{
	"name": "@intellibiz/create-intellibiz",
	"version": "1.18.2",
	"type": "module",
	"private": false,
	"description": "Scaffold a new Intellibiz application — npm create @intellibiz/intellibiz",
	"license": "Apache-2.0",
	"author": "Lethabo Khedama",
	"homepage": "https://github.com/picklem0b/intellibiz#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/picklem0b/intellibiz.git",
		"directory": "tools/create-intellibiz"
	},
	"bugs": {
		"url": "https://github.com/picklem0b/intellibiz/issues"
	},
	"keywords": [
		"intellibiz",
		"create",
		"scaffold",
		"starter",
		"template"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"create-intellibiz": "./dist/bin.cjs"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown src/index.ts src/bin.ts --format esm,cjs --dts --clean --sourcemap --target es2022",
		"dev": "tsdown src/index.ts src/bin.ts --format esm,cjs --dts --clean --sourcemap --target es2022 --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@intellibiz/cli": "workspace:*",
		"consola": "^3.4.2"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
